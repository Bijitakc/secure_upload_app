FLASK_CONFIG=development
FLASK_APP=core/wsgi.py
SECRET_KEY=
DATABASE_URI=postgresql://postgres:change-me@localhost:5432/upload_db
TEST_DATABASE_URI=postgresql://postgres:change-me@localhost:5432/upload_db_test

# DB
DB_USER=postgres
DB_PASSWORD=

# file upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_EXTENSIONS='["jpeg", "jpg", "png", "webp"]'
ALLOWED_FILE_TYPES='["image/jpeg", "image/png", "image/jpg", "image/webp"]'

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=
# In seconds
PRESIGNED_URL_EXPIRATION_TIME=ave 
S3_ENDPOINT_URL=
S3_KEY_PREFIX=attachments/files

#Auth0
AUTH0_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=
AUTH0_REGULAR_CLIENT_ID=
