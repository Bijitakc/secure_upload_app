# AWS credentials
# For LocalStack, use dummy credentials (test/test).
# For AWS, use credentials from your AWS account or another supported credential provider.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Terraform input variables
TF_VAR_project_name=secure-upload-app
TF_VAR_environment=dev
TF_VAR_aws_account_id=
TF_VAR_aws_region=us-east-1

# Optional: LocalStack endpoint
# Leave unset when targeting real AWS.
TF_VAR_localstack_endpoint=

TF_VAR_frontend_origin=
TF_VAR_s3_key_prefix=attachments/files